import { VerticalBox, ScrollView } from "std-widgets.slint";

component ImageCard inherits Rectangle {
    in property <image> img;
    
    width: 240px;
    height: 240px;
    border-radius: 8px;
    background: #f0f0f000;
    drop-shadow-blur: 4px;
    drop-shadow-color: #00000040;
    
    Image {
        source: img;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
}

component ImageRow inherits HorizontalLayout {
    in property <[image]> row-images;
    spacing: 16px;
    alignment: center;
    
    for img in row-images: ImageCard {
        img: img;
    }
}

export component ImageGallery inherits Window {
    title: "Image Gallery";
    preferred-width: 820px;
    preferred-height: 600px;
    
    in property <[image]> images: [];
    in property <[[image]]> image-rows: [];
    out property <length> current-width: root.width;
    
    callback width-changed(length);
    
    changed current-width => {
        width-changed(current-width);
    }
    
    VerticalBox {
        padding: 16px;
        
        Text {
            text: "Thumbnail Gallery";
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            color: #333;
        }
        
        ScrollView {
            VerticalLayout {
                spacing: 16px;
                padding: 8px;
                
                for row in image-rows: ImageRow {
                    row-images: row;
                }
            }
        }
    }
}
